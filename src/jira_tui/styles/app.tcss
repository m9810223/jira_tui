/* Jira Dashboard 主要樣式 */

Screen {
    layout: grid;
    grid-size: 1;
}

TabbedContent {
    height: 100%;
}

/* API Tab 設定表單 */
#config-form {
    padding: 1 2;
    height: auto;
}

#config-form Label {
    margin-top: 1;
}

#config-form Input {
    margin-bottom: 1;
    border: solid $primary;
}

#verify-btn {
    margin-top: 1;
    width: auto;
}

#api-status {
    margin-top: 1;
    height: auto;
}

#api-status.success {
    color: $success;
}

#api-status.error {
    color: $error;
}

/* JQL Tab */
#jql-bar {
    height: auto;
    padding: 0 1;
}

#jql-input {
    height: 1;
    max-height: 10;
    width: 1fr;
    border: none;
    background: $primary;
}

#search-btn {
    width: auto;
    height: 1;
    margin-left: 1;
    border: none;
    padding: 0;
}

#jql-loading {
    height: 1fr;
}

#results-table {
    height: 1fr;
    overflow-x: auto;
    overflow-y: auto;
}

#results-status {
    height: auto;
    padding: 0 1;
    text-align: center;
    color: $text-muted;
}

/* My Issues Tab */
#assignee-bar {
    height: 1;
    padding: 0 1;
    align: left middle;
}

#assignee-label {
    width: auto;
    height: 1;
}

#assignee-value {
    width: 1fr;
    height: 1;
    padding: 0 1;
    background: $primary;
}

#change-assignee-btn {
    width: auto;
    min-width: 8;
    height: 1;
    margin-left: 1;
    border: none;
    padding: 0;
}

.hidden {
    display: none;
}

#breadcrumb {
    height: 1;
    padding: 0 1;
    background: $surface;
    color: $text-muted;
}

#timeline-header {
    height: 1;
    overflow: hidden;
}

#my-issues-loading {
    height: 1fr;
}

#my-issues-container {
    height: 1fr;
    overflow-y: auto;
}

#my-issues-container DataTable {
    height: auto;
    max-height: 15;
}

.table-label {
    height: auto;
    padding: 0 1;
    color: $text-muted;
    text-style: bold;
}

/* Worklog Tab */
#worklog-toolbar {
    height: auto;
    padding: 0 1;
    align: left middle;
}

#worklog-toolbar Button {
    width: auto;
    min-width: 8;
    margin-right: 1;
}

#worklog-date-label {
    width: 14;
    content-align: center middle;
    text-style: bold;
}

#worklog-draft-summary {
    width: 1fr;
    content-align: left middle;
    color: $text-muted;
}

#worklog-zoom-label {
    width: 10;
    content-align: right middle;
    color: $text-muted;
}

#worklog-loading {
    height: auto;
}

#worklog-body {
    height: 1fr;
    padding: 0 1 1 1;
}

#worklog-scroll {
    width: 1fr;
    height: 1fr;
    margin-right: 1;
}

#worklog-scroll-body {
    height: auto;
}

#worklog-time-axis {
    width: 7;
    height: auto;
    color: $text-muted;
}

.time-axis-hour {
    color: $primary;
    text-style: bold;
}

.time-axis-half {
    color: $text-muted;
}

.worklog-entry-base {
    background: $surface;
}

.worklog-draft {
    background: $primary 20%;
    border-left: thick $primary;
}

#worklog-day-grid {
    width: 1fr;
    height: auto;
    border: solid $primary;
}

#worklog-issue-picker {
    width: 38;
    height: 1fr;
    border: solid $primary;
    padding: 1;
}

.worklog-pane-title {
    height: auto;
    margin-bottom: 1;
    text-style: bold;
}

#worklog-issue-filter {
    margin-bottom: 1;
}

#worklog-issue-list {
    height: 12;
    margin-bottom: 1;
}

#worklog-issue-meta {
    height: auto;
    color: $text-muted;
    margin-bottom: 1;
}

#worklog-message {
    height: 6;
    margin-bottom: 1;
}

#worklog-submit-btn {
    width: 100%;
}

#worklog-status {
    height: auto;
    padding: 0 1;
    color: $text-muted;
}

/* Worklog Editor Modal */
WorklogEditorModal {
    align: center middle;
}

#worklog-editor-dialog {
    width: 120;
    height: 54;
    max-height: 100%;
    padding: 1 2;
    background: $surface;
    border: thick $primary;
}

#worklog-editor-header {
    height: auto;
    margin-bottom: 1;
    width: 100%;
    align: left middle;
}

#worklog-editor-date {
    width: 1fr;
    content-align: right middle;
    color: $text-muted;
}

#worklog-editor-body {
    height: 1fr;
}

#worklog-editor-scroll {
    width: 1fr;
    height: 1fr;
}

#worklog-editor-scroll-body {
    height: auto;
}

#worklog-editor-axis {
    width: 8;
    height: auto;
    color: $text-muted;
}

#worklog-editor-grid {
    width: 1fr;
    height: auto;
    border: round $primary-background;
}

#worklog-editor-side {
    width: 36;
    margin-left: 2;
}

#worklog-editor-comment {
    height: 8;
    margin-top: 1;
}

#worklog-editor-summary {
    margin-top: 1;
    color: $text-muted;
}

#worklog-editor-buttons {
    height: auto;
    align: right middle;
    margin-top: 1;
}

#worklog-editor-buttons Button {
    margin-left: 1;
}
